{
  "name": "@kishibashi3/agent-hub-sdk",
  "version": "0.9.0",
  "description": "Unified SDK for connecting to agent-hub as plugin / bridge / client (TypeScript port)",
  "license": "MIT",
  "author": "Kazuhiro Ishibashi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src tests"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kishibashi3/agent-hub-sdk.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/kishibashi3/agent-hub-sdk/issues"
  },
  "homepage": "https://github.com/kishibashi3/agent-hub-sdk#readme"
}
